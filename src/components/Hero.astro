---

<section id="accueil" class="pt-24 pb-16 md:pt-32 md:pb-24 bg-gradient-to-br from-primary-50 via-white to-secondary-100">
  <div class="container mx-auto px-4">
    <div data-aos="slide-right" class="max-w-4xl mx-auto text-center mt-16">
      <h1 class="text text-6xl"><span class="text-secondary-600">TN</span> WEB CONCEPT</h1>
      <h2 class="text-4xl md:text-6xl font-bold text-gray-900 mb-6">
        Développeur <span class="text-secondary-600">Full-Stack</span>
        <br />
        <!-- <span class="text-accent-600">Angular & Symfony</span> -->
      </h2>
      
      <p class="text-xl md:text-2xl text-gray-600 mb-8">
        Transformez vos idées en applications web performantes et sur mesure
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
        <a 
          href="#contact" 
          class="px-8 py-4 bg-secondary-600 text-white rounded-lg font-semibold hover:bg-gray-500 transition-colors shadow-lg hover:shadow-xl"
        >
          Démarrer un projet
        </a>
        <a 
          href="#portfolio" 
          class="px-8 py-4 bg-white text-gray-700 rounded-lg font-semibold hover:bg-gray-50 transition-colors border-2 border-secondary-600"
        >
          Voir mes réalisations
        </a>
      </div>

      <div class="flex flex-wrap justify-center gap-8 text-sm text-gray-600">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-accent-600" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          <span>Certifié CDA (Bac+3/4)</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-accent-600" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          <span>Disponible en freelance</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-accent-600" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          <span>250-300€ / jour</span>
        </div>
      </div>
    </div>
  </div>
</section>
