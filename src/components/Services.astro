---
const services = [
  {
    icon: "🌐",
    title: "Site Vitrine",
    description:
      "Création de sites web modernes et élégants pour présenter votre activité et attirer de nouveaux clients.",
    features: [
      "Design sur mesure",
      "Responsive",
      "SEO optimisé",
      "Formulaire de contact",
    ],
  },
  {
    icon: "🛒",
    title: "Site E-commerce",
    description:
      "Boutiques en ligne complètes avec gestion des produits, paiements sécurisés et suivi des commandes.",
    features: [
      "Catalogue produits",
      "Panier",
      "Paiement sécurisé",
      "Tableau de bord",
    ],
  },
  {
    icon: "💼",
    title: "Application Web",
    description:
      "Applications métier sur mesure pour digitaliser vos processus et améliorer votre productivité.",
    features: [
      "Fonctionnalités sur mesure",
      "Interface intuitive",
      "Sécurisé",
      "Évolutif",
    ],
  },
  {
    icon: "🎨",
    title: "Refonte de Site",
    description:
      "Modernisation de votre site existant avec un design actuel et des performances optimisées.",
    features: [
      "Design moderne",
      "Amélioration UX",
      "Performance",
      "Migration de contenu",
    ],
  },
  {
    icon: "🔧",
    title: "Maintenance & Support",
    description:
      "Maintenance technique, mises à jour de sécurité et support continu pour votre site web.",
    features: [
      "Mises à jour",
      "Corrections bugs",
      "Support technique",
      "Sauvegardes",
    ],
  },
  {
    icon: "📱",
    title: "Site Responsive",
    description:
      "Sites web parfaitement adaptés à tous les écrans : ordinateur, tablette et smartphone.",
    features: ["Mobile-first", "Tablette", "Desktop", "Performance"],
  },
];
---

<section id="services" class="relative z-10 py-16 md:py-24 bg-white">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-5xl font-bold text-gray-900 mb-4">
        Mes Services
      </h2>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        Une expertise complète pour vos projets web, du concept à la mise en
        production
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        services.map((service, index) => (
          <div
            class="bg-gray-50 rounded-xl p-8 hover:shadow-lg transition-shadow border border-gray-200"
            data-aos="fade-up"
            data-aos-delay={index * 100}
            data-aos-duration="600"
          >
            <div class="text-5xl mb-4">{service.icon}</div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">
              {service.title}
            </h3>
            <p class="text-gray-600 mb-4">{service.description}</p>
            <div class="flex flex-wrap gap-2">
              {service.features.map((tech) => (
                <span class="text-xs px-3 py-1 bg-primary-100 text-primary-700 rounded-full font-medium">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
