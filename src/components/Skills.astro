---
const skillCategories = [
  {
    category: 'Frontend',
    icon: '🎨',
    skills: ['Angular', 'React', 'TypeScript', 'HTML/CSS', 'Tailwind CSS', 'JavaScript']
  },
  {
    category: 'Backend',
    icon: '⚙️',
    skills: ['Symfony', 'PHP', 'Node.js', 'API REST', 'MySQL', 'PostgreSQL', 'SQL', 'PhpMyAdmin']
  },
  {
    category: 'DevOps & Outils',
    icon: '🚀',
    skills: ['Docker', 'Git', 'Linux', 'CI/CD', 'Postman', 'Nginx']
  },
  {
    category: 'Design & Gestion',
    icon: '📋',
    skills: ['Figma', 'Trello', 'Agile/Scrum', 'UML', 'Responsive Design', 'UI/UX']
  }
];
---

<section id="competences" class="py-16 md:py-24 bg-white">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-5xl font-bold text-gray-900 mb-4">
        Compétences
      </h2>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        Une expertise complète pour concrétiser vos projets web
      </p>
    </div>

    <div class="max-w-6xl mx-auto grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {skillCategories.map((category) => (
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-200 hover:border-primary-500 hover:shadow-lg transition-all duration-300">
          <div class="text-4xl mb-4 text-center">{category.icon}</div>
          <h3 class="text-xl font-bold text-gray-900 mb-4 text-center">
            {category.category}
          </h3>
          <div class="flex flex-wrap gap-2 justify-center">
            {category.skills.map((skill) => (
              <span class="px-3 py-1.5 bg-white text-gray-700 rounded-full text-sm border border-gray-200 hover:border-primary-500 hover:text-primary-600 transition-colors">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="mt-16 max-w-4xl mx-auto">
      <div class="bg-gradient-to-r from bg-secondary-500 to-secondary-700 rounded-xl p-8 text-black text-center shadow-xl">
        <div class="flex items-center justify-center gap-3 mb-4">
          <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          <h3 class="text-2xl font-bold">Certification Professionnelle</h3>
        </div>
        <p class="text-lg font-semibold mb-2">
          Concepteur Développeur d'Applications (CDA)
        </p>
        <p class="text-black/90">
          Titre RNCP Niveau 6 (Bac+3/4) - Certifié 2024
        </p>
      </div>
    </div>

    <div class="mt-12 text-center">
      <p class="text-gray-600 max-w-3xl mx-auto">
        Technologies modernes, bonnes pratiques et veille technologique constante pour des solutions web performantes et pérennes.
      </p>
    </div>
  </div>
</section>