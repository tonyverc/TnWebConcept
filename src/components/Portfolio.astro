---
const projects = [
  {
    title: 'France Marine Services',
    description: 'Application web complète avec catalogue produits public et interface d\'administration sécurisée.',
    image: 'logo-fms-sans-fond.png',
    technologies: ['Angular', 'Symfony', 'MySQL', 'Docker', 'JWT'],
    features: [
      'Catalogue produits avec filtres avancés',
      'Interface admin avec EasyAdmin',
      'Authentification JWT',
      '14 endpoints API RESTful',
      'Design responsive Tailwind CSS'
    ],
    link: '/projets/france-marine-services'
  },
  {
    title: "Allure d'or",
    description: 'Plateforme de vente en ligne avec gestion complète des produits et commandes.',
    image: 'logo-allure-dor.png',
    technologies: ['Symfony', 'Stripe', 'MySQL', 'Twig'],
    features: [
      'Panier et gestion commandes',
      'Paiement sécurisé Stripe',
      'Panel admin complet',
      'Système de notifications'
    ],
    link: '/projets/allure-d-or'
  }
];
---

<section id="portfolio" class="py-16 md:py-24 bg-gray-50">
  <div class="container mx-auto px-4">
    <div 
      class="text-center mb-16"
      data-aos="fade-down"
      data-aos-duration="600"
    >
      <h2 class="text-3xl md:text-5xl font-bold text-gray-900 mb-4">
        Portfolio
      </h2>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        Découvrez quelques-unes de mes réalisations récentes
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-8 max-w-6xl mx-auto">
      {projects.map((project, index) => (
        <div 
          
          class="bg-white rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-shadow"
          data-aos={index % 2 === 0 ? "fade-right" : "fade-left"}
          data-aos-duration="700"
          data-aos-delay={index * 150}
        >
          <div 
            class="h-48  flex items-center justify-center"
            data-aos="zoom-in"
            data-aos-duration="500"
            data-aos-delay={index * 150 + 200}
          >
            <img 
              src={project.image} 
              alt={project.title} 
              class="h-full  object-cover"
            />
          </div>
          
          <div class="p-8">
            <h3 
              class="text-2xl font-bold text-gray-900 mb-3"
              data-aos="fade-up"
              data-aos-duration="500"
              data-aos-delay={index * 150 + 300}
            >
              {project.title}
            </h3>
            <p 
              class="text-gray-600 mb-4"
              data-aos="fade-up"
              data-aos-duration="500"
              data-aos-delay={index * 150 + 400}
            >
              {project.description}
            </p>

            <div 
              class="mb-4"
              data-aos="fade-up"
              data-aos-duration="500"
              data-aos-delay={index * 150 + 500}
            >
              <h4 class="font-semibold text-gray-900 mb-2">Fonctionnalités :</h4>
              <ul class="space-y-1">
                {project.features.map((feature, featureIndex) => (
                  <li 
                    class="text-sm text-gray-600 flex items-start gap-2"
                    data-aos="fade-right"
                    data-aos-duration="400"
                    data-aos-delay={index * 150 + 600 + (featureIndex * 50)}
                  >
                    <svg class="w-4 h-4 text-accent-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                    </svg>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div 
              class="flex flex-wrap gap-2 mb-6"
              data-aos="fade-up"
              data-aos-duration="500"
              data-aos-delay={index * 150 + 800}
            >
              {project.technologies.map((tech) => (
                <span class="text-xs px-3 py-1 bg-primary-100 text-primary-700 rounded-full font-medium">
                  {tech}
                </span>
              ))}
            </div>

            <a 
              href={project.link}
              class="inline-flex items-center gap-2 text-primary-600 font-semibold hover:text-primary-700 transition-colors"
              data-aos="fade-left"
              data-aos-duration="500"
              data-aos-delay={index * 150 + 900}
            >
              Voir le projet
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>