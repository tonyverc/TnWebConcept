---
---

<section id="contact" class="py-16 md:py-24 bg-white">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-5xl font-bold text-gray-900 mb-4">
        Contact
      </h2>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        Un projet en tête ? Discutons-en !
      </p>
    </div>

    <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12">
      <div>
        <h3 class="text-2xl font-bold text-gray-900 mb-6">
          Envoyez-moi un message
        </h3>
        
        <form class="space-y-6" id="contact-form" action="https://formspree.io/f/xanrrvga" method="POST">
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
              Nom complet *
            </label>
            <input 
              type="text" 
              id="name" 
              name="name"
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition"
              placeholder="Jean Dupont"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
              Email *
            </label>
            <input 
              type="email" 
              id="email" 
              name="email"
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition"
              placeholder="jean.dupont@exemple.fr"
            />
          </div>

          <div>
            <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">
              Téléphone
            </label>
            <input 
              type="tel" 
              id="phone" 
              name="phone"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition"
              placeholder="06 12 34 56 78"
            />
          </div>

          <div>
            <label for="project" class="block text-sm font-medium text-gray-700 mb-2">
              Type de projet
            </label>
            <select 
              id="project" 
              name="project"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition"
            >
              <option value="">Sélectionnez...</option>
              <option value="site-vitrine">Site vitrine</option>
              <option value="application-web">Application web</option>
              <option value="ecommerce">E-commerce</option>
              <option value="api">API / Backend</option>
              <option value="maintenance">Maintenance / Évolution</option>
              <option value="autre">Autre</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-gray-700 mb-2">
              Message *
            </label>
            <textarea 
              id="message" 
              name="message"
              required
              rows="5"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition resize-none"
              placeholder="Décrivez votre projet..."
            ></textarea>
          </div>

          <!-- RGPD Consent -->
          <div class="flex items-start gap-3">
            <input 
              type="checkbox" 
              id="rgpd-consent" 
              name="rgpd-consent"
              required
              value="accepted"
              class="mt-1 w-4 h-4 text-primary-600 border-gray-300 rounded focus:ring-primary-500"
            />
            <label for="rgpd-consent" class="text-sm text-gray-600">
              J'accepte que mes données soient collectées et traitées dans le cadre de ma demande de contact. 
              <a href="/mentions-legales#donnees-personnelles" class="text-primary-600 hover:text-primary-700 underline">
                En savoir plus sur la gestion de vos données personnelles
              </a>
              *
            </label>
          </div>

          <!-- Honeypot anti-spam -->
          <input type="text" name="_gotcha" style="display:none" />

          <button 
            type="submit"
            class="w-full px-8 py-4 bg-secondary-600 text-white rounded-lg font-semibold hover:bg-gray-700 transition-colors shadow-lg hover:shadow-xl disabled:opacity-50 disabled:cursor-not-allowed"
            id="submit-btn"
          >
            Envoyer le message
          </button>
        </form>

        <div id="form-message" class="mt-4 hidden"></div>
      </div>

      <div class="space-y-8">
        <div>
          <h3 class="text-2xl font-bold text-gray-900 mb-6">
            Informations
          </h3>
          
          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-primary-600" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
                  <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 mb-1">Email</h4>
                <a href="mailto:contact@tnwebconcept.fr" class="text-gray-600 hover:text-primary-600 transition-colors">
                  contact@tnwebconcept.fr
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-primary-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 mb-1">Localisation</h4>
                <p class="text-gray-600">
                  Hauts-de-France<br />
                  Interventions France entière
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-primary-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 mb-1">Disponibilité</h4>
                <p class="text-gray-600">
                  Disponible en freelance<br />
                  Demander un devis gratuit
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-gradient-to-br from-primary-50 to-accent-50 rounded-xl p-8 border border-primary-200">
          <h4 class="text-xl font-bold text-gray-900 mb-4">
            Réponse rapide garantie
          </h4>
          <p class="text-gray-700">
            Je m'engage à vous répondre sous 24h maximum. Pour les demandes urgentes, n'hésitez pas à le mentionner dans votre message.
          </p>
        </div>

        <div class="bg-blue-50 rounded-xl p-6 border border-blue-200">
          <div class="flex items-start gap-3">
            <svg class="w-6 h-6 text-blue-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
            </svg>
            <div>
              <h4 class="font-semibold text-blue-900 mb-2">Protection de vos données</h4>
              <p class="text-sm text-blue-800">
                Vos données sont traitées de manière confidentielle et ne sont jamais transmises à des tiers. Vous disposez d'un droit d'accès, de rectification et de suppression.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const messageDiv = document.getElementById('form-message');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const consentCheckbox = document.getElementById('rgpd-consent') as HTMLInputElement;

  // Désactive le bouton si la checkbox n'est pas cochée
  consentCheckbox?.addEventListener('change', () => {
    submitBtn.disabled = !consentCheckbox.checked;
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    // Vérifie le consentement
    if (!consentCheckbox.checked) {
      messageDiv?.classList.remove('hidden');
      messageDiv!.className = 'mt-4 p-4 bg-red-100 text-red-700 rounded-lg';
      messageDiv!.textContent = 'Vous devez accepter le traitement de vos données personnelles pour envoyer ce formulaire.';
      return;
    }

    // Désactive le bouton pendant l'envoi
    submitBtn.disabled = true;
    submitBtn.textContent = 'Envoi en cours...';
    
    try {
      // Envoi réel vers Formspree
      const formData = new FormData(form);
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: {
          'Accept': 'application/json'
        }
      });

      if (response.ok) {
        messageDiv?.classList.remove('hidden');
        messageDiv!.className = 'mt-4 p-4 bg-green-100 text-green-700 rounded-lg';
        messageDiv!.textContent = 'Message envoyé avec succès ! Je vous recontacterai rapidement.';
        form.reset();
      } else {
        throw new Error('Erreur lors de l\'envoi');
      }
    } catch (error) {
      messageDiv?.classList.remove('hidden');
      messageDiv!.className = 'mt-4 p-4 bg-red-100 text-red-700 rounded-lg';
      messageDiv!.textContent = 'Une erreur est survenue. Veuillez réessayer ou m\'écrire directement à contact@tnwebconcept.fr';
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Envoyer le message';
      
      setTimeout(() => {
        messageDiv?.classList.add('hidden');
      }, 5000);
    }
  });
</script>