---
import ProjetLayout from "../../layouts/ProjetLayout.astro";
---

<ProjetLayout
    title="Allure d'or"
    description="Site e-commerce de vente en ligne avec gestion des produits et commandes."
>
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-40 flex">
        <div class="bg-white rounded-lg shadow-lg p-8 align-center mx-auto justify-center text-center">
            <h1 class="text-4xl font-bold text-gray-900 mb-6">Page en cours de construction</h1>
            <p class="text-xl text-gray-600">Revenez bientôt pour découvrir le projet Allure d'or en détail !</p>
        </div>
    </main>
</ProjetLayout>