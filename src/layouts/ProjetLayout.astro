---
import Layout from './Layout.astro';



interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<Layout title={`${title} - TN Web Concept`} description={description}>
  <div class="min-h-screen bg-gray-50 flex flex-col">

    <!-- Contenu du projet -->
     <main class="flex-grow">

       <slot />

     </main>

  </div>
</Layout>